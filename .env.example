# Generate independently with: uv run python -c "import secrets; print(secrets.token_hex(32))"
SMS_RELAY_API_KEY=replace-with-a-random-64-character-secret
SMS_RELAY_SESSION_SECRET=replace-with-a-different-random-64-character-secret

# Public URL and cookie path must describe the same reverse-proxy prefix.
SMS_RELAY_COOKIE_PATH=/sms-relay/
SMS_RELAY_BIND_ADDRESS=127.0.0.1
SMS_RELAY_BIND_PORT=8000

# Feishu custom application credentials and OAuth configuration.
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
FEISHU_REDIRECT_URI=https://relay.example.com/sms-relay/auth/callback
FEISHU_ALLOWED_OPEN_IDS=ou_replace_me

# Optional. Leave empty to disable group notifications.
FEISHU_CHAT_ID=
