# Generate independently with: uv run python -c "import secrets; print(secrets.token_hex(32))"
SMS_RELAY_API_KEY=replace-with-a-random-64-character-secret
SMS_RELAY_READ_API_KEY=replace-with-a-second-random-64-character-secret

# Public URL and cookie path must describe the same reverse-proxy prefix.
SMS_RELAY_COOKIE_PATH=/sms-relay/
SMS_RELAY_BIND_ADDRESS=127.0.0.1
SMS_RELAY_BIND_PORT=8000

# Optional override for the mailbox configuration path; blank uses /data/mailboxes.json.
# Create and manage mailboxes in the web UI, or edit that file manually; see docs/EMAIL.md.
SMS_RELAY_MAILBOXES_FILE=

# Central OAuth public-client contract. Values must exactly match the central registry.
AUTH_ISSUER=https://auth.midi.lizhijian.xyz
AUTH_CLIENT_ID=sms-relay-web
AUTH_AUDIENCE=sms-relay-api
AUTH_SCOPES=sms-relay:access
AUTH_REDIRECT_URI=https://api.midi.lizhijian.xyz/sms-relay/auth/callback
AUTH_POST_LOGOUT_REDIRECT_URI=https://api.midi.lizhijian.xyz/sms-relay/?auto_sso=off
# Optional server-side transport override for networks that reset TLS with SNI.
# TLS still verifies the public CA-signed IP SAN certificate; do not use a hostname here.
AUTH_BACKCHANNEL_IP=
AUTH_SESSION_IDLE_SECONDS=43200
AUTH_SESSION_ABSOLUTE_SECONDS=604800
AUTH_INTROSPECTION_CACHE_SECONDS=5

# Optional Feishu bot credentials. These are not used for browser authentication.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
